# Copy to .env.local for local dev. Never commit .env.local (it's in .gitignore).
# In Vercel: Project → Settings → Environment Variables, same names.

# Neon → Connect → "Pooled connection" string (host contains -pooler), with ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# http://localhost:3000 locally; https://<your-project>.vercel.app in Vercel
APP_URL=http://localhost:3000

# Entra admin center → App registrations → your app → Overview → Application (client) ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Certificates & secrets → New client secret → copy the VALUE (shown once), not the Secret ID
AZURE_CLIENT_SECRET=
# common = any work/school account + personal Microsoft accounts
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_CACHE_KEY=

# Optional: comma-separated emails allowed to sign in. Empty = open demo.
ALLOWED_EMAILS=
